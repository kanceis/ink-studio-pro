{
  "name": "ink-studio-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p functions && tsc --noEmit -p workers/follow-ups",
    "test:unit": "tsx --test tests/followUps.test.ts",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-ink-studio \"tsx --test --test-concurrency=1 tests/firestore.rules.test.ts tests/followUpsWorker.test.ts tests/vouchers.test.ts\"",
    "emulators": "npx --yes firebase-tools@15 emulators:start --only auth,firestore --project demo-ink-studio",
    "pages:dev": "wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
